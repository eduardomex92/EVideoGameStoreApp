@model Platform

@{
	ViewData["Title"] = "Delete Platform";
}

<div class="row text">
	<div class="col-md-8 offset-2">
		<p>
			<h1>
				Delete Confirmation for @Model.Name
			</h1>
		</p>
		<div class="row">
			<div class="col-md-8 offset-2">
					<div class="form-group text-center">
						<img class="border-info" style="max-width: 150px" id="LogoUrlPreview" />
					</div>
					<div class="form-group">
						<label asp-for="LogoUrl" class="control-label"></label>
						<input asp-for="LogoUrl" class="form-control" readonly/>
						<span asp-validation-for="LogoUrl" class="text-danger"></span>
					</div>
					<div class="form-group">
						<label asp-for="Name" class="control-label"></label>
						<input asp-for="Name" class="form-control" readonly/>
						<span asp-validation-for="Name" class="text-danger"></span>
					</div>
					<div class="form-group">
						<label asp-for="Description" class="control-label"></label>
						<textarea asp-for="Description" class="form-control" rows="5" readonly></textarea>
						<span asp-validation-for="Description" class="text-danger"></span>
					</div>
					<div class="form-group">
						<label asp-for="Manufacturer" class="control-label"></label>
						<input asp-for="Manufacturer" class="form-control" readonly/>
						<span asp-validation-for="Manufacturer" class="text-danger"></span>
					</div>
					<div class="form-group">
						<form asp-action="DeleteConfirmed">
						<input type="hidden" asp-for="Id" />
							<p>Are you sure you want to delete this Platform?</p>
							<input type="submit" value="Delete" class="btn btn-danger float-right" />
						</form>
						<a class="btn btn-outline-secondary" asp-action="Index">Show All</a>
					</div>
				<div asp-validation-summary="All" class="text-danger"></div>

			</div>
		</div>

	</div>
</div>

@section Scripts {
	<script>
		$(document).ready(function (){
			var output = document.getElementById('LogoUrlPreview');
			output.src = $("#LogoUrl").val()
		});

	</script>
}