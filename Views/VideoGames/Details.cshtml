@model EVideoGameStoreApp.Models.VideoGame
@using EVideoGameStoreApp.Data.Enums


@{
    ViewData["Title"] = "Game Details";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <div class="card mb-4 shadow-sm">
            <div class="row g-0">
                <div class="col-md-12">
                    <div class="card-header bg-dark text-white">
                        <h5 class="card-title mb-0">
                            @Model.Title
                            @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                            {
                                <a class="text-white float-end" asp-action="Edit" asp-route-id="@Model.Id">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                            }
                        </h5>
                    </div>
                </div>

                <div class="col-md-4">
                    <img src="@Model.CoverImageUrl" class="img-fluid" alt="@Model.Title" style="height: 100%; width: 100%; object-fit: cover;" />
                </div>

                <div class="col-md-8">
                    <div class="card-body">
                        <p class="card-text">@Model.Description</p>
                        <p class="card-text">
                            <strong>Categories:</strong>
                            @foreach (VideoGameCategory category in Enum.GetValues(typeof(VideoGameCategory)))
                            {
                                if (category != VideoGameCategory.None && Model.VideoGameCategory.HasFlag(category))
                                {
                                    <span class="badge bg-secondary me-1">@category</span>
                                }
                            }
                        </p>
                        <p class="card-text">
                            <strong>Developer:</strong>
                            <a asp-controller="Developer" asp-action="Details" asp-route-id="@Model.DeveloperId">@Model.Developer?.Name</a>
                        </p>
                        <p class="card-text">
                            <strong>Publisher:</strong>
                            <a asp-controller="Publisher" asp-action="Details" asp-route-id="@Model.PublisherId">@Model.Publisher?.Name</a>
                        </p>
                        <p class="card-text"><strong>Release Date:</strong> @Model.ReleaseDate.ToString("MMM dd, yyyy")</p>
                        <p class="card-text"><strong>Price:</strong> @Model.Price.ToString("C")</p>

                        @if (Model.VideoGamePlatforms?.Any() == true)
                        {
                            <p class="card-text">
                                <strong>Available on:</strong><br />
                                @foreach (var platform in Model.VideoGamePlatforms)
                                {
                                    <a class="badge bg-info text-dark me-1 text-decoration-none"
                                       asp-controller="Platform"
                                       asp-action="Details"
                                       asp-route-id="@platform.Platform.Id">
                                        @platform.Platform.Name
                                    </a>
                                }
                            </p>

                        }
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="card-footer d-flex justify-content-between">
                        <a class="btn btn-outline-secondary" asp-action="Index">
                            <i class="bi bi-arrow-left-circle"></i> Back to List
                        </a>
                        <a class="btn btn-success text-white"
                           asp-controller="Orders"
                           asp-action="AddItemToShoppingCart"
                           asp-route-id="@Model.Id">
                            <i class="bi bi-cart-plus"></i> Add to Cart
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
